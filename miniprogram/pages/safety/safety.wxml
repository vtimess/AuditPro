<view class="safety-page safe-bottom">
  <view class="tabs"><view class="tab {{activeTab === 'check' ? 'active' : ''}}" data-tab="check" bindtap="switchTab">安全检查</view><view class="tab {{activeTab === 'records' ? 'active' : ''}}" data-tab="records" bindtap="switchTab">检查记录</view><view class="tab {{activeTab === 'rectification' ? 'active' : ''}}" data-tab="rectification" bindtap="switchTab">整改任务</view></view>
  <view wx:if="{{activeTab === 'check'}}" class="form-card card">
    <view class="section-title">基础信息</view>
    <view class="field"><text>检查项目 *</text><input placeholder="请输入项目名称" data-field="inspection_project" value="{{form.inspection_project}}" bindinput="inputField"/></view><view class="field"><text>所属地区 *</text><input data-field="region" value="{{form.region}}" bindinput="inputField"/></view><view class="field"><text>检查区域 *</text><input placeholder="码头、库区、设备区等" data-field="inspection_area" value="{{form.inspection_area}}" bindinput="inputField"/></view><view class="field"><text>检查人员 *</text><input data-field="inspectors" value="{{form.inspectors}}" bindinput="inputField"/></view><view class="field location-field"><text>现场位置</text><input disabled placeholder="点击右侧获取" value="{{form.location_text}}"/><button bindtap="chooseLocation">获取位置</button></view><view class="field"><text>天气</text><input placeholder="选填" data-field="weather" value="{{form.weather}}" bindinput="inputField"/></view>
    <view class="section-title checks-title">现场整备情况</view><view class="choice-row"><text wx:for="{{readinessOptions}}" wx:key="value" class="{{form.site_readiness === item.value ? 'selected' : ''}}" data-value="{{item.value}}" bindtap="selectReadiness">{{item.label}}</text></view>
    <view class="check-row" wx:for="{{checkItems}}" wx:key="key"><view class="check-row-head"><text>{{item.name}}</text><view wx:if="{{form[item.key] === 'abnormal'}}" class="check-photo-actions"><text data-field="{{item.key}}" bindtap="chooseCheckImage">现场拍照</text><text wx:if="{{checkPhotoCounts[item.key]}}" data-field="{{item.key}}" bindtap="previewCheckImages">预览({{checkPhotoCounts[item.key]}})</text></view></view><view class="mini-choice"><text wx:for="{{statusOptions}}" wx:for-item="option" wx:key="value" class="{{form[item.key] === option.value ? 'selected' : ''}}" data-field="{{item.key}}" data-value="{{option.value}}" bindtap="selectCheckStatus">{{option.label}}</text></view></view>
    <view class="section-title checks-title">危险点（{{form.hazards.length}}）</view><view class="hazard-card" wx:for="{{form.hazards}}" wx:key="index"><view><b>{{item.hazard_name}}</b><text>{{item.category}} · {{item.risk_level === 'major' ? '重大' : item.risk_level === 'high' ? '较大' : '一般'}}</text></view><text data-index="{{index}}" bindtap="removeHazard">删除</text></view><button class="outline" bindtap="openHazard">＋ 添加危险点</button>
    <view class="upload-title">现场照片</view><view class="image-grid"><image wx:for="{{inspectionImages}}" wx:key="*this" src="{{item}}" mode="aspectFill"/><view wx:if="{{inspectionImages.length < 9}}" class="add-image" bindtap="chooseInspectionImage">＋<text>现场拍照</text></view></view>
    <view class="field vertical"><text>检查说明</text><textarea placeholder="记录现场整体情况" data-field="description" value="{{form.description}}" bindinput="inputField"/></view><button class="primary" bindtap="submitInspection">保存安全检查</button>
  </view>
  <block wx:elif="{{activeTab === 'records'}}"><view wx:if="{{!inspections.length}}" class="empty">暂无安全检查记录</view><view class="record card" wx:for="{{inspections}}" wx:key="id"><view class="record-head"><b>{{item.inspection_project}}</b><text class="risk {{item.highest_risk_level}}">{{item.risk_text}}</text></view><view class="line">{{item.inspection_area}} · {{item.inspected_at}}</view><view class="line">危险点 {{item.hazard_count}} 个 · 整改完成 {{item.rectification_progress}}%</view><view wx:if="{{item.has_overdue}}" class="overdue">存在逾期整改</view></view></block>
  <block wx:else><view wx:if="{{!rectifications.length}}" class="empty">暂无整改任务</view><view class="record card" wx:for="{{rectifications}}" wx:key="id"><view class="record-head"><b>{{item.hazard_name}}</b><text class="risk {{item.risk_level}}">{{item.risk_text}}</text></view><view class="line">责任人：{{item.responsible_person}}</view><view class="line">整改期限：{{item.rectification_deadline}}</view><view class="line">{{item.rectification_requirement}}</view><view wx:if="{{item.is_overdue}}" class="overdue">已逾期</view><button wx:if="{{item.status === 'pending'}}" class="small-primary" data-id="{{item.id}}" bindtap="rectify">上传整改照片并提交</button><button wx:elif="{{item.status === 'pending_review' && canReview}}" class="review-button" data-id="{{item.id}}" bindtap="review">执行复查</button><view wx:else class="task-status">{{item.status_text}}</view></view></block>
  <view wx:if="{{hazardVisible}}" class="modal-mask"><view class="modal"><view class="modal-title">添加危险点</view><view class="field"><text>危险点名称 *</text><input data-field="hazard_name" value="{{hazard.hazard_name}}" bindinput="inputHazard"/></view><view class="field"><text>类别 *</text><picker range="{{categories}}" bindchange="changeHazardCategory"><view class="picker">{{hazard.category}} ›</view></picker></view><view class="field"><text>风险等级 *</text><picker range="{{riskOptions}}" range-key="label" bindchange="changeHazardRisk"><view class="picker">{{riskOptions[hazardRiskIndex || 0].label}} ›</view></picker></view><view class="field"><text>责任人 *</text><input data-field="responsible_person" value="{{hazard.responsible_person}}" bindinput="inputHazard"/></view><view class="field"><text>整改期限 *</text><picker mode="date" value="{{hazard.rectification_deadline}}" bindchange="changeDeadline"><view class="picker">{{hazard.rectification_deadline || '请选择'}} ›</view></picker></view><view class="field vertical"><text>问题描述 *</text><textarea data-field="description" value="{{hazard.description}}" bindinput="inputHazard"/></view><view class="field vertical"><text>整改要求 *</text><textarea data-field="rectification_requirement" value="{{hazard.rectification_requirement}}" bindinput="inputHazard"/></view><view class="switch-row"><text>需要立即停工</text><switch checked="{{hazard.immediate_stop}}" bindchange="toggleStop" color="#d85f4c"/></view><button class="outline" bindtap="chooseHazardImage">添加危险点照片（{{hazard.images.length}}）</button><view class="modal-actions"><button bindtap="closeHazard">取消</button><button class="submit" bindtap="saveHazard">确定</button></view></view></view>
</view>

.profile-page{min-height:100vh;padding:24rpx 28rpx 300rpx;box-sizing:border-box}.skeleton{height:260rpx}.profile-hero{padding:38rpx 30rpx;display:flex;align-items:center;border-radius:22rpx;background:linear-gradient(135deg,#173a50,#245e77);color:#fff}.avatar{width:108rpx;height:108rpx;border-radius:50%;border:4rpx solid rgba(255,255,255,.5)}.avatar.fallback{display:flex;align-items:center;justify-content:center;background:#e8f2f7;color:#176c9b;font-size:42rpx;font-weight:700}.profile-info{flex:1;margin-left:24rpx}.profile-name{font-size:36rpx;font-weight:700}.profile-meta{margin-top:10rpx;color:#c7dce5;font-size:22rpx}.edit{padding:10rpx 20rpx;border:1rpx solid rgba(255,255,255,.35);border-radius:24rpx;font-size:21rpx}.menu{margin-top:24rpx;padding:0 28rpx}.menu-item{height:106rpx;display:flex;align-items:center;border-bottom:1rpx solid #edf0f1}.menu-item:last-child{border-bottom:0}.menu-icon{width:58rpx;height:58rpx;border-radius:15rpx;display:flex;align-items:center;justify-content:center;margin-right:20rpx;font-size:21rpx;font-weight:700}.menu-icon.blue{background:#e8f2f7;color:#176c9b}.menu-icon.green{background:#e7f3ee;color:#32947e}.menu-icon.orange{background:#fbf1e5;color:#d89438}.menu-icon.gray{background:#eff1f2;color:#72818a}.menu-item text{flex:1;font-size:26rpx}.arrow{color:#a0aab0;font-size:38rpx}.profile-footer{position:fixed;left:28rpx;right:28rpx;bottom:calc(80rpx + env(safe-area-inset-bottom));z-index:2}.logout{width:100%;height:88rpx;padding:0;border-radius:16rpx;background:#fff;color:#e26350;display:flex;align-items:center;justify-content:center;line-height:1;text-align:center;font-size:27rpx}.version{margin-top:26rpx;text-align:center;color:#a0a9ae;font-size:19rpx}

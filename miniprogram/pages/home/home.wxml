<view class="home-page safe-bottom">
  <block wx:if="{{loading}}">
    <view class="skeleton card"></view>
    <view class="skeleton card short"></view>
  </block>

  <block wx:elif="{{home}}">
    <view class="hero">
      <view class="hero-top">
        <view>
          <view class="date-label">港务审计 · 移动作业平台</view>
          <view class="greeting">{{home.greeting}}</view>
          <view class="summary">{{home.summary}}</view>
        </view>
        <view class="message-badge">{{home.unread_count}}</view>
      </view>
      <view class="identity-chip">{{home.user.role_name}}<text wx:if="{{home.user.org_name}}"> · {{home.user.org_name}}</text></view>
    </view>

    <view class="metric-grid">
      <view class="metric card" wx:for="{{home.metrics}}" wx:key="key">
        <view class="metric-label">{{item.label}}</view>
        <view class="metric-value {{item.tone}}">{{item.value}}<text>{{item.unit}}</text></view>
      </view>
    </view>

    <view class="section-head">
      <view><view class="section-title">快捷入口</view><view class="section-desc">本期功能入口</view></view>
    </view>
    <view class="quick-card card" bindtap="openWorkbench">
      <view class="quick-icon">台</view>
      <view class="quick-content"><view>进入工作台</view><text>查看人员、派工、打卡等规划模块</text></view>
      <view class="arrow">›</view>
    </view>

    <view class="section-head"><view><view class="section-title">今日动态</view><view class="section-desc">系统通知与工作提醒</view></view></view>
    <view class="empty card">
      <view class="empty-mark">✓</view>
      <view class="empty-title">暂无待处理事项</view>
      <view class="empty-desc">新的任务和风险提醒会显示在这里</view>
    </view>
  </block>
</view>

.home-page { padding: 24rpx 28rpx 40rpx; }
.skeleton { margin-bottom: 24rpx; height: 300rpx; }.skeleton.short { height: 180rpx; }
.hero { padding: 38rpx 32rpx 34rpx; color: #fff; border-radius: 24rpx; background: linear-gradient(135deg, #173a50, #20779b); box-shadow: 0 16rpx 36rpx rgba(23, 58, 80, .18); }
.hero-top { display: flex; justify-content: space-between; align-items: flex-start; }.date-label { color: #acd0df; font-size: 21rpx; letter-spacing: 1rpx; }.greeting { margin-top: 18rpx; font-size: 40rpx; font-weight: 700; }.summary { margin-top: 14rpx; color: #d4e6ed; font-size: 23rpx; }
.message-badge { min-width: 38rpx; height: 38rpx; padding: 0 8rpx; border-radius: 20rpx; background: #e26350; display: flex; align-items: center; justify-content: center; font-size: 20rpx; box-sizing: border-box; }.identity-chip { display: inline-flex; margin-top: 34rpx; padding: 9rpx 18rpx; border: 1rpx solid rgba(255,255,255,.2); border-radius: 24rpx; background: rgba(255,255,255,.1); color: #e7f2f6; font-size: 21rpx; }
.metric-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 18rpx; margin-top: 22rpx; }.metric { padding: 27rpx 25rpx; }.metric-label { color: #71808b; font-size: 22rpx; }.metric-value { margin-top: 12rpx; font-family: Georgia, serif; font-size: 43rpx; font-weight: 700; }.metric-value text { margin-left: 7rpx; color: #80909a; font-family: sans-serif; font-size: 20rpx; font-weight: 400; }.metric-value.blue{color:#176c9b}.metric-value.green{color:#32947e}.metric-value.orange{color:#d89438}.metric-value.red{color:#e26350}
.section-head { margin: 38rpx 4rpx 18rpx; display:flex; justify-content:space-between; align-items:end; }.section-title { font-size: 30rpx; font-weight: 700; }.section-desc { margin-top: 5rpx; color: #8b979e; font-size: 20rpx; }
.quick-card { padding: 28rpx; display: flex; align-items: center; }.quick-icon { width: 76rpx; height: 76rpx; border-radius: 18rpx; display:flex;align-items:center;justify-content:center;background:#e8f2f7;color:#176c9b;font-weight:700 }.quick-content { flex: 1; margin-left: 22rpx; font-size: 27rpx; font-weight: 600; }.quick-content text { display:block;margin-top:7rpx;color:#87949c;font-size:20rpx;font-weight:400 }.arrow{color:#a0aab0;font-size:42rpx}
.empty { padding: 46rpx 20rpx; text-align:center }.empty-mark{margin:0 auto 16rpx;width:64rpx;height:64rpx;border-radius:50%;display:flex;align-items:center;justify-content:center;background:#e7f3ee;color:#32947e;font-size:31rpx;font-weight:700}.empty-title{font-size:26rpx;font-weight:600}.empty-desc{margin-top:10rpx;color:#8a969d;font-size:21rpx}

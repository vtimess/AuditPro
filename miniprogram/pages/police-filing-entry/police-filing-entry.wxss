.entry-page{padding:20rpx 26rpx 50rpx}.form-card{padding:30rpx}.form-title{font-size:31rpx;font-weight:700}.form-desc{margin-top:8rpx;color:#819099;font-size:20rpx}.section-title{margin-top:30rpx;padding-left:14rpx;border-left:6rpx solid #176c9b;color:#263943;font-size:24rpx;font-weight:700}.field{min-height:96rpx;border-bottom:1rpx solid #edf0f1;display:flex;align-items:center;justify-content:space-between}.field>text{width:200rpx;flex-shrink:0;font-size:23rpx}.field input,.field picker,.picker{flex:1;min-width:0;text-align:right;color:#263943;font-size:23rpx}.field.readonly view{flex:1;text-align:right;color:#829099;font-size:22rpx}.field.vertical{display:block;padding:24rpx 0}.field textarea{width:100%;height:140rpx;margin-top:16rpx;padding:18rpx;box-sizing:border-box;background:#f5f7f7;border-radius:12rpx;font-size:22rpx}.form-actions{display:flex;gap:16rpx;margin-top:30rpx}.form-actions button{flex:1;margin:0}.form-actions .cancel{background:#eef1f2;color:#667780}.form-actions .primary{background:#176c9b;color:#fff}

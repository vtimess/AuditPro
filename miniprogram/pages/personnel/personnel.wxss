.personnel-page{padding:20rpx 26rpx 50rpx}.page-head{padding:34rpx 30rpx;display:flex;align-items:center;justify-content:space-between;border-radius:22rpx;background:linear-gradient(135deg,#173a50,#176c9b);box-shadow:0 12rpx 30rpx rgba(23,58,80,.16)}.page-title{color:#fff;font-size:32rpx;font-weight:700}.page-desc{margin-top:9rpx;color:rgba(255,255,255,.72);font-size:20rpx}.page-head button{width:190rpx;height:68rpx;line-height:68rpx;margin:0 0 0 20rpx;padding:0;border-radius:14rpx;background:#fff;color:#176c9b;font-size:22rpx;font-weight:700}.search-card{margin-top:20rpx;padding:12rpx;display:flex;align-items:center;gap:8rpx}.search-card input{flex:1;min-width:0;height:64rpx;padding:0 14rpx;box-sizing:border-box;background:#f4f6f7;border-radius:11rpx;font-size:19rpx}.search-card .action-button{flex:0 0 96rpx;width:96rpx;height:64rpx;line-height:64rpx;margin:0;padding:0;border-radius:11rpx;font-size:20rpx}.search-card .query-button{background:#176c9b;color:#fff}.search-card .export-button{background:#e5f0f5;color:#176c9b}.list-summary{height:78rpx;padding:0 4rpx;display:flex;align-items:center;justify-content:space-between;color:#788790;font-size:21rpx}.list-summary text:first-child{color:#344853;font-size:24rpx;font-weight:700}.record-card{margin-bottom:16rpx;padding:25rpx}.record-head{display:flex;align-items:center;justify-content:space-between}.record-head>view{display:flex;align-items:center;gap:13rpx}.record-head b{font-size:28rpx}.staff-no{padding:6rpx 10rpx;border-radius:8rpx;background:#e7f2f7;color:#176c9b;font-size:18rpx}.employment{padding:6rpx 13rpx;border-radius:18rpx;background:#e4f3ed;color:#2e8067;font-size:18rpx}.employment.left{background:#edf0f1;color:#77858d}.record-line{margin-top:12rpx;color:#687781;font-size:21rpx}.record-actions{display:flex;justify-content:flex-end;gap:28rpx;margin-top:15rpx;font-size:20rpx}.record-actions text:first-child{color:#176c9b}.record-actions text:last-child{color:#c45b4c}.empty{text-align:center;padding:100rpx 0;color:#9aa5ab}

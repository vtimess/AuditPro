.attendance-page{min-height:100vh;padding:20rpx 28rpx 48rpx;box-sizing:border-box}.tabs{height:76rpx;padding:6rpx;display:flex;background:#e9edef;border-radius:16rpx;margin-bottom:24rpx}.tab{flex:1;display:flex;align-items:center;justify-content:center;color:#71808b;border-radius:12rpx;font-size:26rpx}.tab.active{background:#fff;color:#176c9b;font-weight:700;box-shadow:0 4rpx 12rpx rgba(31,57,71,.07)}.skeleton{height:420rpx}.today-card{padding:36rpx 32rpx;border-radius:24rpx;background:linear-gradient(135deg,#173a50,#216f91);color:#fff}.today-label{font-size:21rpx;color:#a9cad8}.today-date{margin-top:8rpx;font-size:34rpx;font-weight:700}.timeline{margin-top:38rpx}.timeline-item{display:flex;position:relative}.dot{width:24rpx;height:24rpx;margin:8rpx 22rpx 0 0;border:5rpx solid #7394a5;border-radius:50%;box-sizing:border-box;background:#173a50}.dot.done{border-color:#5cc6a5;background:#d9f2ea}.timeline-content{flex:1}.timeline-title{font-size:24rpx;color:#d7e6ec}.timeline-time{margin-top:5rpx;font-family:Georgia,serif;font-size:44rpx;font-weight:700}.timeline-location{margin-top:7rpx;color:#a9c6d2;font-size:20rpx}.timeline-line{height:48rpx;margin-left:10rpx;border-left:3rpx dashed rgba(255,255,255,.22)}.location-card{margin-top:22rpx;padding:24rpx;display:flex;align-items:center}.location-icon{width:66rpx;height:66rpx;border-radius:17rpx;display:flex;align-items:center;justify-content:center;background:#e8f2f7;color:#176c9b;font-weight:700}.location-info{flex:1;margin-left:18rpx;font-size:25rpx}.location-info text{display:block;margin-top:7rpx;color:#84929a;font-size:19rpx}.locate-button{margin:0;padding:0 18rpx;height:58rpx;display:flex;align-items:center;justify-content:center;border:1rpx solid #cddde4;border-radius:12rpx;background:#fff;color:#176c9b;font-size:21rpx;line-height:1}.punch-button{height:150rpx;margin-top:34rpx;padding:0;border-radius:75rpx;display:flex;flex-direction:column;align-items:center;justify-content:center;background:linear-gradient(135deg,#176c9b,#32947e);color:#fff;font-size:34rpx;font-weight:700;line-height:1.2;box-shadow:0 16rpx 34rpx rgba(23,108,155,.23)}.punch-button text{margin-top:12rpx;font-size:19rpx;font-weight:400;color:#d6ebed}.punch-tip{text-align:center;margin-top:22rpx;color:#89969d;font-size:20rpx}.month-header{padding:25rpx 18rpx;display:flex;align-items:center;justify-content:space-between;text-align:center}.month-header picker{flex:1}.month-select{padding:4rpx 10rpx}.month-arrow{width:62rpx;height:62rpx;border-radius:50%;display:flex;align-items:center;justify-content:center;background:#eef3f5;color:#176c9b;font-size:45rpx}.month-title{font-size:31rpx;font-weight:700}.month-subtitle{margin-top:5rpx;color:#89969d;font-size:19rpx}.summary-row{display:grid;grid-template-columns:repeat(3,1fr);gap:14rpx;margin:18rpx 0}.summary-row view{padding:19rpx;text-align:center;background:#fff;border-radius:15rpx}.summary-row b,.summary-row text{display:block}.summary-row b{font-size:33rpx;color:#32947e}.summary-row b.orange{color:#e29a3e}.summary-row b.blue{color:#176c9b}.summary-row text{margin-top:5rpx;color:#7c8b94;font-size:19rpx}.calendar{padding:17rpx;display:grid;grid-template-columns:repeat(7,1fr);gap:8rpx}.week{height:54rpx;display:flex;align-items:center;justify-content:center;color:#7a8992;font-size:20rpx}.day{height:90rpx;border-radius:12rpx;display:flex;flex-direction:column;align-items:center;justify-content:center;background:#f8f9f9}.day-number{font-size:24rpx}.day-status{margin-top:4rpx;font-size:15rpx;color:#89969d}.day.complete{background:#e8f4ef;color:#297e67}.day.partial,.day.missing{background:#faeee9;color:#d7624f}.day.pending{background:#e9f1f6;color:#176c9b}.day.future{color:#b6bec2;background:#fafafa}.day.today{box-shadow:inset 0 0 0 3rpx #176c9b}.day.blank{background:transparent}.legend{display:flex;justify-content:center;gap:25rpx;margin-top:22rpx;color:#7c8a93;font-size:18rpx}.legend i{display:inline-block;width:15rpx;height:15rpx;margin-right:7rpx;border-radius:4rpx}.legend i.normal{background:#69b39b}.legend i.missing{background:#e47764}.legend i.pending{background:#4f93b5}.modal-mask{position:fixed;inset:0;z-index:30;display:flex;align-items:flex-end;background:rgba(15,32,42,.52)}.supplement-modal{width:100%;padding:34rpx 32rpx calc(38rpx + env(safe-area-inset-bottom));box-sizing:border-box;border-radius:28rpx 28rpx 0 0;background:#fff}.modal-title{text-align:center;font-size:32rpx;font-weight:700}.modal-date{text-align:center;margin-top:8rpx;color:#7d8a92;font-size:21rpx}.form-row{height:94rpx;display:flex;align-items:center;justify-content:space-between;border-bottom:1rpx solid #edf0f1;font-size:25rpx}.picker-value{color:#176c9b}.reason-label{margin-top:24rpx;font-size:24rpx}.reason-input{width:100%;height:150rpx;margin-top:14rpx;padding:20rpx;box-sizing:border-box;border-radius:14rpx;background:#f4f6f7;font-size:23rpx}.modal-actions{display:flex;gap:18rpx;margin-top:28rpx}.modal-actions button{flex:1;height:82rpx;display:flex;align-items:center;justify-content:center;border-radius:14rpx;background:#eef1f2;color:#62717a;font-size:25rpx;line-height:1}.modal-actions button.submit{background:#176c9b;color:#fff}

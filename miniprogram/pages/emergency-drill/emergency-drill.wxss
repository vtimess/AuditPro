.drill-page{padding:20rpx 26rpx 50rpx}.page-head{padding:32rpx 28rpx;display:flex;align-items:center;justify-content:space-between;gap:18rpx;border-radius:22rpx;background:linear-gradient(135deg,#173a50,#176c9b);box-shadow:0 12rpx 30rpx rgba(23,58,80,.16)}.eyebrow{color:#75d1d5;font-size:17rpx;letter-spacing:2rpx}.page-title{margin-top:9rpx;color:#fff;font-size:33rpx;font-weight:700}.page-desc{margin-top:8rpx;color:rgba(255,255,255,.72);font-size:19rpx}.page-head button{flex:0 0 178rpx;width:178rpx;height:66rpx;line-height:66rpx;margin:0;padding:0;border-radius:13rpx;background:#fff;color:#176c9b;font-size:21rpx;font-weight:700}.format-tip{margin-top:18rpx;padding:20rpx 22rpx;display:flex;align-items:center;gap:18rpx}.tip-icon{flex:0 0 72rpx;width:72rpx;height:58rpx;line-height:58rpx;text-align:center;border-radius:11rpx;background:#e7f2f7;color:#176c9b;font-size:17rpx;font-weight:700}.format-tip>view:last-child{min-width:0}.format-tip text{display:block;color:#314751;font-size:22rpx;font-weight:700}.format-tip text:last-child{margin-top:6rpx;color:#829098;font-size:18rpx;font-weight:400;line-height:1.5}.search-card{margin-top:16rpx;padding:12rpx;display:flex;align-items:center;gap:10rpx}.search-card input{flex:1;min-width:0;height:64rpx;padding:0 18rpx;box-sizing:border-box;background:#f4f6f7;border-radius:11rpx;font-size:20rpx}.search-card button{flex:0 0 96rpx;width:96rpx;height:64rpx;line-height:64rpx;margin:0;padding:0;border-radius:11rpx;background:#176c9b;color:#fff;font-size:20rpx}.list-summary{height:78rpx;padding:0 4rpx;display:flex;align-items:center;justify-content:space-between;color:#788790;font-size:21rpx}.list-summary text:first-child{color:#344853;font-size:24rpx;font-weight:700}.record-card{margin-bottom:16rpx;padding:24rpx}.record-main{display:flex;align-items:flex-start;gap:18rpx}.file-badge{flex:0 0 76rpx;width:76rpx;height:82rpx;line-height:82rpx;text-align:center;border-radius:12rpx;background:#e7f2f7;color:#176c9b;font-size:18rpx;font-weight:700}.file-badge.pdf{background:#fbe9e6;color:#b55245}.file-info{flex:1;min-width:0}.file-name{overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:#263943;font-size:25rpx;font-weight:700}.file-meta{margin-top:10rpx;color:#687983;font-size:20rpx}.file-time{margin-top:7rpx;color:#9aa5ab;font-size:18rpx}.record-actions{display:flex;justify-content:flex-end;gap:12rpx;margin-top:18rpx;padding-top:16rpx;border-top:1rpx solid #edf0f1}.record-actions button{width:104rpx;height:56rpx;line-height:56rpx;margin:0;padding:0;border-radius:10rpx;background:#edf3f6;color:#176c9b;font-size:19rpx}.record-actions .export{background:#176c9b;color:#fff}.empty{text-align:center;padding:100rpx 20rpx;color:#9aa5ab;font-size:21rpx}

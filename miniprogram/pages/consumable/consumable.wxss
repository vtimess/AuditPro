.business-page{padding:20rpx 28rpx 50rpx}.tabs{display:flex;padding:6rpx;background:#e8edef;border-radius:16rpx}.tab{flex:1;height:66rpx;display:flex;align-items:center;justify-content:center;color:#74838c}.tab.active{background:#fff;border-radius:12rpx;color:#176c9b;font-weight:700}.toolbar{display:flex;gap:14rpx;padding:16rpx;margin-top:22rpx}.toolbar input{flex:1;padding:0 16rpx;background:#f5f7f7;border-radius:12rpx}.toolbar button{margin:0;width:110rpx;background:#176c9b;color:#fff;font-size:22rpx}.export-button{margin:18rpx 0;background:#e7f2f7;color:#176c9b;font-size:23rpx}.record-card{margin-top:16rpx;padding:25rpx}.record-head{display:flex;justify-content:space-between}.record-head b{font-size:28rpx}.record-head text{color:#176c9b;font-size:30rpx;font-weight:700}.tags{margin-top:12rpx}.tags text{margin-right:10rpx;padding:6rpx 13rpx;background:#edf2f4;border-radius:18rpx;color:#64747d;font-size:18rpx}.tags text.manual{background:#fff0dc;color:#a86d1f}.record-line{margin-top:12rpx;color:#687781;font-size:21rpx}.record-actions{display:flex;justify-content:flex-end;gap:25rpx;margin-top:14rpx;font-size:19rpx}.record-actions text:first-child{color:#176c9b}.record-actions text:last-child{color:#c45b4c}.form-card{margin-top:22rpx;padding:30rpx}.form-title{font-size:30rpx;font-weight:700}.field{min-height:94rpx;border-bottom:1rpx solid #edf0f1;display:flex;align-items:center}.field>text{width:205rpx;font-size:23rpx}.field input,.field picker,.picker{flex:1;text-align:right;font-size:23rpx}.field.split{gap:20rpx}.field.split>view{flex:1;display:flex;align-items:center}.field.split text{margin-right:15rpx}.field.vertical{display:block;padding:24rpx 0}.field textarea{width:100%;height:130rpx;margin-top:14rpx;padding:18rpx;box-sizing:border-box;background:#f5f7f7;border-radius:12rpx;font-size:22rpx}.calculated{padding:15rpx 0;color:#819099;font-size:20rpx}.calculated text{float:right;color:#d47e27}.upload-title{margin-top:26rpx;font-size:23rpx}.image-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14rpx;margin-top:15rpx}.image-item,.add-image{position:relative;height:180rpx;border-radius:12rpx;overflow:hidden}.image-item image{width:100%;height:100%}.image-item>text{position:absolute;right:7rpx;top:7rpx;width:40rpx;height:40rpx;text-align:center;border-radius:50%;background:rgba(0,0,0,.6);color:#fff}.add-image{display:flex;flex-direction:column;align-items:center;justify-content:center;background:#f1f4f5;color:#7c8c95;font-size:42rpx}.add-image text{font-size:18rpx}.primary{margin-top:30rpx;background:#176c9b;color:#fff}.empty{text-align:center;padding:100rpx 0;color:#9aa5ab}

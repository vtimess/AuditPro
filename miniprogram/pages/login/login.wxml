<view class="login-page">
  <view class="harbor-lines"><view></view><view></view><view></view></view>
  <view class="brand-block">
    <view class="brand-mark">SY</view>
    <view class="brand-name">港审通</view>
    <view class="brand-en">AUDITPRO</view>
    <view class="brand-desc">港务审计与现场安全管理平台</view>
  </view>

  <view class="login-card card">
    <view class="welcome-title">欢迎使用</view>
    <view class="welcome-desc">统一身份登录，按角色进入工作台</view>
    <button class="login-button" loading="{{loading}}" disabled="{{loading}}" bindtap="login">
      微信一键登录
    </button>
    <view class="privacy" bindtap="togglePrivacy">
      <view class="checkbox {{privacyChecked ? 'checked' : ''}}">{{privacyChecked ? '✓' : ''}}</view>
      <text>我已阅读并同意《用户服务与隐私说明》</text>
    </view>
  </view>

  <view class="login-footer">星光港务集团 · 数字化审计</view>
</view>

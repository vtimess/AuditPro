.business-page{padding:20rpx 28rpx 50rpx}.tabs{display:flex;padding:6rpx;background:#e8edef;border-radius:16rpx}.tab{flex:1;height:66rpx;display:flex;align-items:center;justify-content:center;color:#74838c}.tab.active{background:#fff;border-radius:12rpx;color:#176c9b;font-weight:700}.toolbar{display:flex;gap:14rpx;padding:16rpx;margin-top:22rpx}.toolbar input{flex:1;padding:0 16rpx;background:#f5f7f7;border-radius:12rpx;font-size:23rpx}.toolbar button{margin:0;width:110rpx;background:#176c9b;color:#fff;font-size:22rpx}.export-button{margin:18rpx 0;background:#e7f2f7;color:#176c9b;font-size:24rpx}.record-card{margin-top:16rpx;padding:25rpx}.record-head{display:flex;justify-content:space-between;align-items:center}.record-head b{font-size:29rpx}.status{padding:7rpx 14rpx;border-radius:20rpx;background:#f2eadb;color:#a56d22;font-size:19rpx}.status.filed{background:#e6f3ed;color:#2d8066}.status.not_required{background:#edf0f1;color:#687781}.record-line{margin-top:12rpx;color:#687781;font-size:22rpx}.record-actions{display:flex;justify-content:flex-end;gap:25rpx;margin-top:14rpx;font-size:19rpx}.record-actions text:first-child{color:#176c9b}.record-actions text:last-child{color:#c45b4c}.form-card{margin-top:22rpx;padding:30rpx}.form-title{font-size:30rpx;font-weight:700;margin-bottom:12rpx}.field{min-height:96rpx;border-bottom:1rpx solid #edf0f1;display:flex;align-items:center;justify-content:space-between}.field>text{width:190rpx;font-size:23rpx}.field input,.picker{flex:1;text-align:right;color:#263943;font-size:23rpx}.field picker{flex:1}.field.vertical{display:block;padding:24rpx 0}.field textarea{width:100%;height:140rpx;margin-top:16rpx;padding:18rpx;box-sizing:border-box;background:#f5f7f7;border-radius:12rpx;font-size:22rpx}.primary{margin-top:30rpx;background:#176c9b;color:#fff}.empty{text-align:center;padding:100rpx 0;color:#9aa5ab}

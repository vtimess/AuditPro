<view class="filing-page safe-bottom">
  <view class="page-head">
    <view><view class="page-title">安全备案</view><view class="page-desc">统一维护人员安全备案信息</view></view>
    <button bindtap="openEntry">＋ 新增备案</button>
  </view>

  <view class="search-card card">
    <input placeholder="姓名/公司/身份证后四位" value="{{keyword}}" bindinput="inputKeyword" bindconfirm="loadRecords"/>
    <button class="action-button query-button" bindtap="loadRecords">查询</button>
    <button class="action-button export-button" bindtap="exportExcel">导出</button>
  </view>

  <view class="list-summary"><text>备案人员</text><text>共 {{records.length}} 人</text></view>
  <view wx:if="{{!loading && !records.length}}" class="empty">暂无备案人员</view>
  <view class="record-card card" wx:for="{{records}}" wx:key="id">
    <view class="record-head"><b>{{item.person_name}}</b><text class="status {{item.filing_status}}">{{item.status_text}}</text></view>
    <view class="record-line">{{item.gender}} · {{item.age}}岁 · {{item.id_card}}</view>
    <view class="record-line">{{item.company_name}}</view>
    <view class="record-line">所属地区：{{item.region}} · {{item.mobile}}</view>
    <view class="record-actions"><text data-id="{{item.id}}" bindtap="editRecord">修改</text><text data-id="{{item.id}}" bindtap="deleteRecord">删除</text></view>
  </view>
</view>

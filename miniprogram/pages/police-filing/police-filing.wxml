<view class="business-page safe-bottom">
  <view class="tabs"><view class="tab {{activeTab === 'list' ? 'active' : ''}}" data-tab="list" bindtap="switchTab">备案人员</view><view class="tab {{activeTab === 'form' ? 'active' : ''}}" data-tab="form" bindtap="switchTab">新增备案</view></view>
  <block wx:if="{{activeTab === 'list'}}">
    <view class="toolbar card"><input placeholder="姓名、公司或身份证后四位" value="{{keyword}}" bindinput="inputKeyword" bindconfirm="loadRecords"/><button bindtap="loadRecords">查询</button></view>
    <button class="export-button" bindtap="exportExcel">导出 Excel</button>
    <view wx:if="{{!loading && !records.length}}" class="empty">暂无备案人员</view>
    <view class="record-card card" wx:for="{{records}}" wx:key="id">
      <view class="record-head"><b>{{item.person_name}}</b><text class="status {{item.filing_status}}">{{item.status_text}}</text></view>
      <view class="record-line">{{item.gender}} · {{item.id_card}}</view><view class="record-line">{{item.company_name}}</view><view class="record-line">所属地区：{{item.region}}</view><view class="record-actions"><text data-id="{{item.id}}" bindtap="editRecord">修改</text><text data-id="{{item.id}}" bindtap="deleteRecord">删除</text></view>
    </view>
  </block>
  <view wx:else class="form-card card">
    <view class="form-title">{{editingId ? '修改备案信息' : '人员基本信息'}}</view>
    <view class="field"><text>人员姓名 *</text><input placeholder="请输入姓名" data-field="person_name" value="{{form.person_name}}" bindinput="inputField"/></view>
    <view class="field"><text>性别 *</text><picker range="{{genderOptions}}" value="{{genderIndex}}" bindchange="changeGender"><view class="picker">{{form.gender}} ›</view></picker></view>
    <view class="field"><text>身份证号 *</text><input type="idcard" maxlength="18" placeholder="请输入18位身份证号" data-field="id_card" value="{{form.id_card}}" bindinput="inputField"/></view>
    <view class="field"><text>公司名称 *</text><input placeholder="请输入公司名称" data-field="company_name" value="{{form.company_name}}" bindinput="inputField"/></view>
    <view class="field"><text>所属地区 *</text><input data-field="region" value="{{form.region}}" bindinput="inputField"/></view>
    <view class="field"><text>联系电话</text><input type="number" placeholder="选填" data-field="mobile" value="{{form.mobile}}" bindinput="inputField"/></view>
    <view class="field"><text>备案状态</text><picker range="{{statusOptions}}" range-key="label" value="{{statusIndex}}" bindchange="changeStatus"><view class="picker">{{statusOptions[statusIndex].label}} ›</view></picker></view>
    <view class="field" wx:if="{{form.filing_status === 'filed'}}"><text>备案日期 *</text><picker mode="date" value="{{form.filing_date}}" bindchange="changeDate"><view class="picker">{{form.filing_date || '请选择'}} ›</view></picker></view>
    <view class="field vertical"><text>备注</text><textarea maxlength="500" placeholder="选填" data-field="remarks" value="{{form.remarks}}" bindinput="inputField"/></view>
    <button class="primary" bindtap="submit">{{editingId ? '保存修改' : '保存备案信息'}}</button>
  </view>
</view>

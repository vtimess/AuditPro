.workbench-page { padding: 24rpx 28rpx 40rpx; }.workbench-hero{padding:34rpx 30rpx;border-radius:22rpx;background:#173a50;color:#fff}.eyebrow{font-size:18rpx;letter-spacing:3rpx;color:#89b3c5}.hero-title{margin-top:13rpx;font-size:40rpx;font-weight:700}.hero-desc{margin-top:10rpx;color:#c7dce5;font-size:22rpx}.skeleton{height:360rpx;margin-top:22rpx}.module-section{margin-top:32rpx}.section-title{margin:0 4rpx 15rpx;font-size:28rpx;font-weight:700}.module-grid{display:grid;grid-template-columns:repeat(3,1fr);padding:16rpx 6rpx}.module{position:relative;padding:25rpx 6rpx 22rpx;text-align:center}.module-icon{margin:0 auto;width:72rpx;height:72rpx;border-radius:18rpx;display:flex;align-items:center;justify-content:center;background:#e8f2f7;color:#176c9b;font-size:23rpx;font-weight:700}.module-name{margin-top:14rpx;font-size:23rpx;font-weight:600}.module-status{margin-top:7rpx;color:#9aa5ab;font-size:18rpx}
